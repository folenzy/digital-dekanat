# Образец deploy/.env для сервера. Скопируй в .env (рядом с docker-compose.yml) и подставь значения.
# Сам .env не коммитить и никому не пересылать. Пошагово — docs/DEPLOY.md.

# Адрес сайта. Пока без домена — бесплатный адрес sslip.io: IP сервера, где точки заменены дефисами,
# плюс .sslip.io. Например, IP 203.0.113.10 → 203-0-113-10.sslip.io (такое имя само указывает на этот IP).
# Появится домен — впиши его сюда (например, nasvyazi.example.ru) и перезапусти: docker compose up -d
SITE_HOST=203-0-113-10.sslip.io

# Пароль PostgreSQL. Сгенерируй на сервере: openssl rand -hex 24
# (только буквы и цифры — он подставляется в DATABASE_URL ниже без экранирования).
POSTGRES_PASSWORD=

# Адрес базы во внутренней сети Docker: хост db, пароль — из строки выше (Compose подставит сам).
DATABASE_URL=postgres://nasvyazi:${POSTGRES_PASSWORD}@db:5432/nasvyazi

# Пароли публичных тестовых учёток — должны совпадать с таблицей в README.md (их вводит жюри).
DEMO_PASSWORD_ALINA=hMtspaT4g9kWa6LD
DEMO_PASSWORD_DENIS=LXxap4LZ7KsaXDSt
DEMO_PASSWORD_IRINA=KFBAuGtzNmn3AzX7

# Токен ночного сброса демо (заголовок x-reset-token, только внутри сети Docker).
# Сгенерируй на сервере: openssl rand -hex 32
DEMO_RESET_TOKEN=

# Сайт работает только по HTTPS: cookie сессии __Host-ns_session с флагом Secure.
COOKIE_SECURE=true

# Необязательно: куда класть ежедневные бэкапы (по умолчанию папка backups/ рядом с docker-compose.yml).
# BACKUP_DIR=./backups
