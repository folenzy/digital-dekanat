# Caddy: HTTPS (сертификат Let's Encrypt выпускается сам), сжатие, HSTS, прокси на приложение.
# Адрес сайта — SITE_HOST из deploy/.env: <IP-через-дефисы>.sslip.io или свой домен (docs/DEPLOY.md).
#
# trusted_proxies намеренно не задан: тогда Caddy не верит X-Forwarded-For, присланному клиентом,
# и передаёт приложению свой — с настоящим адресом клиента. По нему приложение ограничивает попытки входа.

{$SITE_HOST} {
	# сжимаем всё, кроме потока событий: gzip/zstd могут держать SSE в буфере
	@compress not path /api/events*
	encode @compress zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# Служебные маршруты (ночной сброс демо) — только из внутренней сети Docker, снаружи их «нет»
	respond /api/internal* 404

	# Все копии приложения (APP_REPLICAS в .env): Caddy спрашивает у DNS Docker адреса контейнеров
	# сервиса app и обновляет список раз в 5 с — число копий меняется без правки этого файла.
	# Проверено замером 1–3 копий: loadtest/README.md.
	reverse_proxy {
		dynamic a app 3000 {
			refresh 5s
		}
		lb_policy round_robin
		# копия перезапускается или ещё стартует — пробуем другую, а не отдаём ошибку сразу
		lb_try_duration 5s
		# поток событий /api/events (SSE): отдаём сразу, без буферизации
		flush_interval -1
	}
}
