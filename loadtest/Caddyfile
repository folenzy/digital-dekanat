# Caddy стенда: как deploy/Caddyfile, но без HTTPS и с распределением по всем копиям `app`.
#
# `dynamic a app 3000` — Caddy сам спрашивает у DNS Docker адреса всех контейнеров сервиса app
# и обновляет список: `docker compose up --scale app=N` добавляет копию без правки этого файла.
# В deploy/Caddyfile сейчас `reverse_proxy app:3000` — одна копия; для нескольких нужны эти же строки.

{
	auto_https off
	admin off
}

:80 {
	@compress not path /api/events*
	encode @compress zstd gzip

	reverse_proxy {
		dynamic a app 3000 {
			refresh 2s
		}
		lb_policy round_robin
		# копия ещё стартует или уже остановлена — пробуем следующую, а не отдаём ошибку
		lb_try_duration 5s
		flush_interval -1
	}
}
