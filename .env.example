# Скопируй в .env и подставь свои значения. .env не коммитить.
# Локальная БД из docker-compose.dev.yml
DATABASE_URL=postgres://nasvyazi:nasvyazi@localhost:5432/nasvyazi
DATABASE_URL_TEST=postgres://nasvyazi:nasvyazi@localhost:5433/nasvyazi_test

# Пароли демо-студентов (задай свои)
DEMO_PASSWORD_ALINA=change-me
DEMO_PASSWORD_DENIS=change-me
DEMO_PASSWORD_IRINA=change-me

# Токен для POST /api/internal/demo-reset (заголовок x-reset-token) (длинная случайная строка)
DEMO_RESET_TOKEN=change-me-long-random-string

# Публичный origin приложения (для проверки Origin в server actions/маршрутах)
APP_ORIGIN=http://localhost:3000
# true за HTTPS (прод), false локально по http
COOKIE_SECURE=false
